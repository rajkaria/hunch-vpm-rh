{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @hunch-rh/web build",
  "outputDirectory": "apps/web/.next",
  "crons": [
    { "path": "/api/cron/open", "schedule": "*/10 12-13 * * 1-5" },
    { "path": "/api/cron/resolve", "schedule": "*/2 20-21 * * 1-5" },
    { "path": "/api/cron/resolve?slot=hourly", "schedule": "7 * * * *" },
    { "path": "/api/cron/deliver", "schedule": "*/5 * * * *" }
  ]
}
