{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    // "." (not "src") so calendar/corporate-actions.json, imported by src/calendar.ts,
    // is emitted next to the code: dist/src/*.js and dist/calendar/*.json.
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "calendar/*.json"]
}
