{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // Typecheck (and tsx) resolve the client from source, so neither needs its dist.
    // The build (tsconfig.build.json) resolves the published types in ../client/dist.
    "paths": {
      "@hunch-rh/client": ["../client/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "calendar/*.json", "vitest.config.ts"]
}
