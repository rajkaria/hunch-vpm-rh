{
  "name": "@hunch-rh/keeper",
  "version": "0.1.0",
  "description": "The Hunch keeper for Robinhood Chain: pure decisions (open, resolve, deliver, relay, health) and a thin runner",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "calendar",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "hunch-keeper": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "keeper": "tsx src/cli.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hunch-rh/client": "workspace:*",
    "date-fns": "^4.4.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
