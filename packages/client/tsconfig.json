{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Only the tests touch node APIs — they read the subgraph schemas off disk
    // to check the queries against them. `src` stays runtime-agnostic.
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
