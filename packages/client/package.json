{
  "name": "@hunch-vpm/client",
  "version": "0.1.0",
  "description": "Typed reads from The Graph and unsigned writes through viem for the Vested Parimutuel on Arc",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "graphql": "^16.9.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": { "node": ">=20" }
}
