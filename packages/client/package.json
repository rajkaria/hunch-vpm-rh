{
  "name": "@hunch-rh/client",
  "version": "0.1.0",
  "description": "Hunch on Robinhood Chain (4663): chain, deployment, ABIs, view-call reads, exact settlement math, Chainlink round finding, gasless USDG entry typed data, NYSE calendar and market copy",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "robinhood-chain",
    "prediction-markets",
    "parimutuel",
    "chainlink",
    "usdg",
    "viem"
  ]
}
