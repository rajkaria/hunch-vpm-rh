# Every one of these is optional for the static pages. With none set, the site
# renders the honest "launching" state and reads Chainlink prices from the
# public Robinhood Chain RPC.

# Canonical origin for metadata, the sitemap and share cards.
NEXT_PUBLIC_SITE_URL=https://rh.playhunch.xyz

# Server-only Robinhood Chain RPC (keyed provider). Falls back to the public
# https://rpc.mainnet.chain.robinhood.com when unset. Never NEXT_PUBLIC_.
RH_RPC_URL=

# Rehearsal override for the deployment file (full JSON string). Server and
# browser copies; see .ocean/PLAN.md "deployments/robinhood-mainnet.json".
HUNCH_DEPLOYMENT_JSON=
NEXT_PUBLIC_HUNCH_DEPLOYMENT_JSON=

# Wallet (wired in S7). WalletConnect project id from https://cloud.reown.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
