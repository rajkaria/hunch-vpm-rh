# Every one of these is optional. With none of them set the surface serves the
# fixture dataset and every page renders — which is the right default while
# nothing is deployed.

# The subgraphs, per network. The toggle in the header picks which Arc a visitor
# reads, and each network reads its own index. A network with no subgraph URL
# serves the fixture dataset and says so. Keyless Studio query URLs only: a
# NEXT_PUBLIC_ value is published to every visitor, and src/lib/data refuses one
# that carries an API key.
#
# The unsuffixed names (NEXT_PUBLIC_HUNCH_SUBGRAPH_URL, _MARKET_IDS,
# NEXT_PUBLIC_ERC8004_SUBGRAPH_URL) predate the toggle and are still read as the
# TESTNET values; mainnet never falls back to them.
# NEXT_PUBLIC_HUNCH_SUBGRAPH_URL_TESTNET=https://api.studio.thegraph.com/query/<id>/hunch-vpm-arc-testnet/<version>
# NEXT_PUBLIC_HUNCH_SUBGRAPH_URL_MAINNET=

# Which markets the board lists, as subgraph ids (<settler>-<index>), comma
# separated. The client answers questions about a market you can name; it has
# no query that enumerates them, so the deployment says which ones it is for.
# These are also the only /m/<id> routes that exist.
# NEXT_PUBLIC_HUNCH_MARKET_IDS_TESTNET=0xc743940c75619f65f6178b7e49c0c3a0be012eec-0
# NEXT_PUBLIC_HUNCH_MARKET_IDS_MAINNET=

# The ERC-8004 subgraph for each chain. Without it, reputation reads are
# unavailable and the agents page says so rather than showing zeros.
# NEXT_PUBLIC_ERC8004_SUBGRAPH_URL_TESTNET=https://api.studio.thegraph.com/query/<id>/erc-8004-arc-testnet/<version>
# NEXT_PUBLIC_ERC8004_SUBGRAPH_URL_MAINNET=

# --- Wallet ---------------------------------------------------------------
# WalletConnect project id, from https://cloud.reown.com. A credential: there is
# deliberately no default, and with none set the site offers browser wallets
# only and says so. Not secret — it is public by design — but it is yours.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Which Arc the deployment transacts on. Anything but "mainnet" means testnet,
# which is the default, so a misconfigured build cannot sign against mainnet.
NEXT_PUBLIC_ARC_NETWORK=testnet

# Override the public RPC endpoints — useful when the public one is rate
# limited. A URL, not a secret, unless your provider embeds a key in it, in
# which case it does not belong in a NEXT_PUBLIC_ variable at all.
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=
NEXT_PUBLIC_ARC_RPC_URL=

# Where an empty wallet gets testnet USDC. USDC is Arc's native gas token, so a
# wallet with none can do nothing at all — not even pay for the transaction that
# would get it started. No default: a wrong faucet link is worse than none, and
# this one is deployment-specific.
NEXT_PUBLIC_ARC_FAUCET_URL=
