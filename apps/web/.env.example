# Every one of these is optional for the pages. With none set, the site renders the honest
# "launching" state (the committed deployments/robinhood-mainnet.json says "not-deployed") and
# reads Chainlink prices from the public Robinhood Chain RPC. Names only; never commit values.

# Canonical origin for metadata, the sitemap and share cards.
NEXT_PUBLIC_SITE_URL=https://rh.playhunch.xyz

# ---------------------------------------------------------------- server only (never NEXT_PUBLIC_)
# Keyed Robinhood Chain RPC. The public https://rpc.mainnet.chain.robinhood.com is the fallback.
RH_RPC_URL=
# A second provider for the keeper's independent STALE read (default: the public RPC).
RH_FALLBACK_RPC_URL=
# The keeper / opener / relayer hot key (mark it sensitive in Vercel). Only needed to send:
# relayed bets, listing, resolving, delivering. Without it the relay answers 503 and the crons
# run read-only.
KEEPER_PRIVATE_KEY=
# Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}`; /api/cron/* is 401 without it.
CRON_SECRET=
# Optional paging from the keeper.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------- public (inlined into the bundle)
# Rehearsal override for the deployment file (full JSON string). Set both to the same JSON: the
# server reads HUNCH_DEPLOYMENT_JSON, the browser NEXT_PUBLIC_HUNCH_DEPLOYMENT_JSON (build time).
HUNCH_DEPLOYMENT_JSON=
NEXT_PUBLIC_HUNCH_DEPLOYMENT_JSON=
# The browser's RPC (public or domain-restricted). Defaults to the public RPC.
NEXT_PUBLIC_RH_RPC_URL=
# WalletConnect (Reown) project id; rh.playhunch.xyz must be on its domain allow-list. The
# WalletConnect option only appears when this is set.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------- local rehearsals only
# The E2E mock wallet (wagmi `mock` over anvil's unlocked accounts). NEVER set for a real deployment.
NEXT_PUBLIC_E2E=
NEXT_PUBLIC_E2E_ACCOUNTS=
# Build into another folder so a rehearsal build never replaces .next (e.g. .next/e2e).
NEXT_DIST_DIR=
