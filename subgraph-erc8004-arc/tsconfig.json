{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  },
  // src/ and tests/matchstick/ are AssemblyScript, not TypeScript: they are compiled by
  // `graph build` and `graph test` against assemblyscript's own stdlib, where tsc's lib types
  // do not apply. Only the Node-side conformance tests are type-checked here.
  "include": ["tests/node/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "generated", "build", "src", "tests/matchstick"]
}
